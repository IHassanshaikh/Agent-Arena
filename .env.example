# ==============================================================================
# AgentArena Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# All variables have sensible local development defaults out of the box.
# ==============================================================================

# Google Gemini API Key (Optional for simulated benchmarks, required for live LLM execution)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Backend API Service
PORT=4000
NODE_ENV=development

# Frontend Web Application
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database Storage Engine
# By default, AgentArena uses embedded PostgreSQL (PGlite) requiring zero setup.
# If connecting to an external PostgreSQL instance, set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/agentarena
